{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly plant care plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week_start", "timezone", "watering", "human_recommendations"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "week_start": {"type": "string", "minLength": 10, "maxLength": 10},
    "timezone": {"type": "string", "enum": ["Europe/Moscow"]},
    "watering": {
      "type": "array",
      "maxItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "plant_id", "pump_id", "start_at", "duration_seconds"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "plant_id": {"type": "string", "enum": ["lemon", "pepper"]},
          "pump_id": {"type": "string", "enum": ["pump_lemon", "pump_pepper"]},
          "start_at": {"type": "string", "minLength": 20, "maxLength": 40},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 30}
        }
      }
    },
    "human_recommendations": {"type": "string", "maxLength": 4000}
  }
}
