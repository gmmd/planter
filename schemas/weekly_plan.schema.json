{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly plant care plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week_start", "timezone", "watering", "human_recommendations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "week_start": {"type": "string", "format": "date"},
    "timezone": {"const": "Europe/Moscow"},
    "watering": {
      "type": "array",
      "maxItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "plant_id", "pump_id", "start_at", "duration_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
          "plant_id": {"enum": ["lemon", "pepper"]},
          "pump_id": {"enum": ["pump_lemon", "pump_pepper"]},
          "start_at": {"type": "string", "format": "date-time"},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 30}
        },
        "allOf": [
          {
            "if": {"properties": {"plant_id": {"const": "lemon"}}},
            "then": {"properties": {"pump_id": {"const": "pump_lemon"}}}
          },
          {
            "if": {"properties": {"plant_id": {"const": "pepper"}}},
            "then": {"properties": {"pump_id": {"const": "pump_pepper"}}}
          }
        ]
      }
    },
    "human_recommendations": {"type": "string", "maxLength": 4000}
  }
}
