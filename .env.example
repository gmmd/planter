# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=123456789:replace_with_your_token

# Recommended: comma-separated numeric Telegram user IDs. Empty allows anyone.
ALLOWED_USER_IDS=123456789

PHOTO_WIDTH=1920
PHOTO_HEIGHT=1080
LOG_LEVEL=INFO
# Optional TrueType font used for the photo watermark.
WATERMARK_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# BCM pin numbering. Lemon uses toggle pulses; pepper is active-low.
LEMON_PUMP_GPIO=17
# Required before pepper watering is enabled; set the actual connected BCM pin.
PEPPER_PUMP_GPIO=27
LEMON_WATERING_SECONDS=10
PEPPER_WATERING_SECONDS=10
# GPIO17 logical on/off pulse width. First pulse starts, second pulse stops.
LEMON_TOGGLE_PULSE_SECONDS=0.2

# Lower resolution and bitrate reduce camera/encoder load and upload time.
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FRAMERATE=24
VIDEO_BITRATE=2000000

# Record before and after the pump cycle so the complete watering is visible.
VIDEO_LEAD_IN_SECONDS=1
VIDEO_LEAD_OUT_SECONDS=0.5

# Weekly automation uses this timezone. Three photos are taken every day.
BOT_TIMEZONE=Europe/Moscow
DAILY_PHOTO_TIMES=10:30,12:30,15:00

# Telegram chats that receive recommendations and automation errors.
# If empty, ALLOWED_USER_IDS is used.
REPORT_CHAT_IDS=123456789

# Hard safety ceiling for an AI-generated watering event.
MAX_WATERING_SECONDS=30
MAX_WATERING_EVENTS=21
# Hard-capped at 16 by the bot, even if an older .env contains a larger value.
AI_PHOTO_LIMIT=16
TELEGRAM_STREAM_STEP_CHARS=400
TELEGRAM_STREAM_INTERVAL_SECONDS=0.3

# Optional values for testing until sensors are connected.
# MOCK_AIR_TEMPERATURE_C=24.5
# MOCK_LEMON_SOIL_MOISTURE_PERCENT=42
# MOCK_PEPPER_SOIL_MOISTURE_PERCENT=38

# Optional local AI response for testing. Leave unset in production.
# AI_RESPONSE_FILE=/path/to/schemas/weekly_plan.example.json

# Yandex AI Studio OpenAI-compatible Responses API.
YANDEX_AI_API_KEY=replace_with_your_api_key
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_PROJECT_ID=b1gr38liecpk6mp2g7ul
YANDEX_AI_PROMPT_ID=fvthisds2b24do0qnn7q
# Keep all selected photos, but resize/compress their API copies to reduce payload.
YANDEX_AI_IMAGE_DETAIL=low
YANDEX_AI_IMAGE_MAX_WIDTH=1280
YANDEX_AI_IMAGE_MAX_HEIGHT=720
YANDEX_AI_IMAGE_JPEG_QUALITY=75
YANDEX_AI_MAX_OUTPUT_TOKENS=4000
YANDEX_AI_TIMEOUT_SECONDS=300
# One retry for transient provider/HTTP errors. Every attempt is logged separately.
YANDEX_AI_REQUEST_RETRIES=1
